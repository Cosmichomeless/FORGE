# Copy to backend/.env. Spring Boot does NOT load this file automatically.
# Export it in your shell as documented in README.md.
DB_URL=jdbc:postgresql://localhost:5432/forge
DB_USER=forge
# Must match the root .env; never commit the real value.
# Local shell-safe format: letters, digits, hyphens, underscores (no spaces/$).
DB_PASSWORD=

# Exact frontend origin allowed by CORS. No trailing slash or wildcard.
APP_FRONTEND_ORIGIN=http://localhost:3000
# Local HTTP only. HTTPS deployments MUST set COOKIE_SECURE=true.
COOKIE_SECURE=false
# Cross-site deployments require SameSite=none AND Secure=true (HTTPS).
COOKIE_SAME_SITE=lax
